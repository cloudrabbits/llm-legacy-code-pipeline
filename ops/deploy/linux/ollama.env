# Ollama 资源稳定性环境变量（env_ollama.ps1 的 Linux 版）
#
# 以 systemd EnvironmentFile 格式书写：每行 KEY=value，不支持引号与 $VAR 展开，
# 值里不要加引号（加了会被当成字面量的一部分）。
#
# 改动后需要重启 Ollama 服务才生效：
#   sudo systemctl restart ollama
#
# 单卡 L20 上显存优先；如需更高吞吐可把 KV cache 改 f16（显存占用约翻倍）。

# 单卡不并发，避免显存翻倍
OLLAMA_NUM_PARALLEL=1
# 只驻留一个模型
OLLAMA_MAX_LOADED_MODELS=1
# 任务间隙不卸载，省掉反复加载
OLLAMA_KEEP_ALIVE=30m
# 27B Q4 首次加载留足 15 分钟
OLLAMA_LOAD_TIMEOUT=900
# KV cache 量化，省显存；不需要就注释掉这一行
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# num_ctx 不在这里设：编排器对每个请求显式下发 options.num_ctx=92160，
# 不依赖全局默认（规格书硬性要求）。
